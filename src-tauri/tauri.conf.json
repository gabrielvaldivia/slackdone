{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Slackdone",
  "version": "0.4.0",
  "identifier": "com.slackdone.desktop",
  "build": {
    "frontendDist": "https://slackdone.vercel.app"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["slackdone"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/gabrielvaldivia/slackdone/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "open": true
    }
  }
}
